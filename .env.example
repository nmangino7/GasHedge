# GasHedge environment variables (Next.js app — see frontend/)
# All optional: the app degrades gracefully and flags fallback data in the UI.

# Vercel Postgres / Neon connection string. Without it, an in-memory store
# (seeded with demo data) is used and resets on restart.
POSTGRES_URL=

# EIA fuel-price API key — https://www.eia.gov/opendata/
EIA_API_KEY=your_eia_api_key_here

# Alpha Vantage ETF-price API key (free tier: 5 calls/min)
ALPHA_VANTAGE_API_KEY=

# Anthropic API key for the AI advisor (Claude). Without it, AI endpoints
# return a clear "not configured" error.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
